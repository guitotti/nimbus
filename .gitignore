# Server app (Flask)
# --------------------------------------
# Arquivos de ambiente virtual
server/venv/
server/.venv/

# Arquivos de cache e específicos do Python
server/__pycache__/
server/*.pyc
server/*.pyo

# Logs
server/*.log

# Arquivos de configurações sensíveis
server/.env
